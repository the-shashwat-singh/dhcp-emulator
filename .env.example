# DHCP Emulator Environment Configuration

# URL for VMs to reach the Mac backend.
# VirtualBox users typically use http://10.0.2.15:8000/internal/event
# UTM users typically use http://10.0.2.2:8000/internal/event
MAC_BACKEND_URL=http://10.0.2.2:8000/internal/event

# Username for the VMs
VM_USER=shashwat

# Path to your SSH private key for accessing the VMs
SSH_KEY_PATH=~/.ssh/id_rsa

# IP addresses of the VMs on the Host-Only network
VM_SERVER_IP=192.168.128.10
VM_RELAY_IP=192.168.128.20
VM_CLIENT_IP=192.168.128.50

# Default gateway for the DHCP subnet
VM_GATEWAY=192.168.128.1
